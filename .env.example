# Planner environment configuration
#
# Copy this file to `.env`, replace every placeholder, and never commit the
# resulting file. Values below are safe examples, not production credentials.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Use `production` for deployed instances.
NODE_ENV=development

# API listen port. API_PORT takes precedence over the generic PORT variable.
API_PORT=3000

# Public application origin used in invitation and password-reset links.
# Do not include a trailing slash.
APP_URL=http://localhost:3000

# Directory containing planner.db and private uploads.
DATA_DIR=./data

# IANA timezone assigned to newly created users.
DEFAULT_TZ=Europe/Istanbul

# Reminder baseline for cards without a start time (24-hour HH:mm format).
DEFAULT_CARD_TIME=09:00

# -----------------------------------------------------------------------------
# Security and initial administrator
# -----------------------------------------------------------------------------

# Generate each value separately with: openssl rand -hex 32
# Access and refresh secrets must be different and at least 32 characters.
# The placeholders below are intentionally rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=replace-with-a-unique-access-signing-secret
JWT_REFRESH_SECRET=replace-with-a-unique-refresh-signing-secret

# JWT validation claims and lifetimes.
JWT_ISSUER=planner-api
JWT_AUDIENCE=planner-clients
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Used only to create the first administrator account.
# Changing these values later does not update an existing account.
ADMIN_EMAIL=admin@example.com
# Required only when bootstrapping the first admin (12-256 characters).
ADMIN_PASSWORD=replace-with-a-long-unique-passphrase

# Comma-separated origins allowed to call the API from a separately hosted UI.
# Leave empty when the web application is served by Planner itself.
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Email (optional)
# -----------------------------------------------------------------------------

# Email features are disabled when these settings are incomplete.
# Port 465 usually uses SMTP_SECURE=true; port 587 usually uses false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Planner <no-reply@example.com>

# -----------------------------------------------------------------------------
# Observability and API documentation
# -----------------------------------------------------------------------------

# Supported levels: trace, debug, info, warn, error, fatal.
LOG_LEVEL=debug

# Emit a warning when an HTTP request exceeds this duration in milliseconds.
SLOW_REQUEST_MS=1000

# Convenient for local development. Set to false on public production systems.
API_DOCS=true
