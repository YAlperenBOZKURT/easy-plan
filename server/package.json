{
  "name": "@planner/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "test": "tsx --test --disable-warning=ExperimentalWarning test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --disable-warning=ExperimentalWarning test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sifre": "tsx --disable-warning=ExperimentalWarning src/cli/set-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.1",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
